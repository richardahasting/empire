# Test database credentials (issue #115). Copy to .env.test and fill in.
# These must NEVER be the production ones: @SpringBootTest boots the real application
# context, and Spring Boot runs Flyway on startup — so a test run against production
# applies migrations to it.
#
#   createdb empire_test -O empire_test_user
#   set -a; . empire-server/.env.test; set +a; mvn test
EMPIRE_TEST_DB_URL=jdbc:postgresql://127.0.0.1:5432/empire_test
EMPIRE_TEST_DB_USER=empire_test_user
EMPIRE_TEST_DB_PASSWORD=
